---
import { SITE } from '../../config/site.config';
---

<footer class="border-t border-border-subtle mt-24">
  <div class="max-w-screen-2xl mx-auto px-8 py-8 flex flex-col sm:flex-row items-center justify-between gap-4">
    <p class="text-text-muted text-sm">{SITE.footer.copyright}</p>

    <div class="flex items-center gap-4">
      {SITE.about.links.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="text-text-muted hover:text-text-secondary text-sm transition-colors duration-200"
        >
          {link.label}
        </a>
      ))}
      <a
        href="/ash-world/rss.xml"
        title="RSS Feed"
        class="text-text-muted hover:text-accent-amber transition-colors duration-200"
        aria-label="RSS Feed"
      >
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19.01 7.38 20 6.18 20C4.98 20 4 19.01 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
